<Project>
  <!-- Bridges TestPulseUrl/TestPulseProject/TestPulseFailOnUnmatched/
       TestPulseDryRun into real process environment variables, using an
       inline RoslynCodeTaskFactory task calling
       System.Environment.SetEnvironmentVariable directly, IN-PROCESS,
       inside the same `dotnet test`/MSBuild process that later spawns
       VSTestTask's vstest.console subprocess, which inherits that
       process's environment normally, the same way any child process
       does. This is the third mechanism tried for this, and the first
       that was actually verified to work end to end against a real
       running TestPulse instance:
         1. VSTestEnvironment only injects environment variables into the
            spawned TEST HOST process, never the separate driver process
            TestPulseLogger itself runs in, confirmed empirically: a
            value set purely via an MSBuild property never reached
            Config.Resolve() there.
         2. Embedding "Key=Value" pairs into $(VSTestLogger) itself, on
            the theory that ITestLoggerWithParameters would receive them
            as logger parameters, failed two different ways: first,
            $(VSTestLogger) turned out to be a semicolon-delimited LIST OF
            LOGGERS (VSTest split "testpulse;Url=..." into separate,
            mostly-invalid logger entries, the same underlying fact
            already responsible for the "junit;testpulse silently drops
            one" discovery elsewhere in this design). Second, even after
            routing the values through a proper generated .runsettings
            file's Logger/Configuration block instead (VSTest's own
            documented mechanism for logger configuration), a diagnostic
            probe proved Initialize's `parameters` dictionary only ever
            contained VSTest's own built-in entries (TestRunDirectory,
            TargetFramework); RunSettings Logger/Configuration values
            are evidently not generically forwarded into
            ITestLoggerWithParameters for third-party loggers.
       BeforeTargets="VSTest" (not AfterTargets) means this always runs
       before VSTestTask executes at all, so it isn't subject to the
       "MSBuild aborts the rest of the target graph once a task fails"
       problem that ruled out AfterTargets elsewhere in this package,
       since this target's own success or failure is unconditional on
       whether the tests themselves later pass or fail. Each variable is
       only set when not already present, preserving "a directly-set
       environment variable is never overwritten", the same semantics
       TestPulseLogger's own Config.Resolve() already documents. -->
  <UsingTask TaskName="TestPulseSetEnvIfUnset" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Name ParameterType="System.String" Required="true" />
      <Value ParameterType="System.String" Required="false" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        if (!string.IsNullOrEmpty(Value) && string.IsNullOrEmpty(System.Environment.GetEnvironmentVariable(Name)))
        {
            System.Environment.SetEnvironmentVariable(Name, Value);
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="TestPulseSetEnvVars" BeforeTargets="VSTest">
    <TestPulseSetEnvIfUnset Name="TESTPULSE_URL" Value="$(TestPulseUrl)" />
    <TestPulseSetEnvIfUnset Name="TESTPULSE_PROJECT" Value="$(TestPulseProject)" />
    <TestPulseSetEnvIfUnset Name="TESTPULSE_FAIL_ON_UNMATCHED" Value="$(TestPulseFailOnUnmatched)" />
    <TestPulseSetEnvIfUnset Name="TESTPULSE_DRY_RUN" Value="$(TestPulseDryRun)" />
  </Target>

  <!-- Reads the .testpulse/result.json marker TestPulseLogger writes
       (from its TestRunComplete handler) and fails the build if it
       indicates submission failure or an unmatched-with-fail-on-unmatched
       outcome. A VSTest logger cannot itself affect dotnet test's exit
       code, confirmed during implementation, so this narrow second use of
       AfterTargets="VSTest" carries that signal instead. Verified safe via
       an isolated repro: AfterTargets="VSTest" reliably fires and an
       Error task inside it reliably sets a non-zero exit code whenever
       VSTestTask itself succeeds (i.e. whenever tests passed). The one
       case this cannot separately signal is tests-failed-and-submission-
       also-failed, where the build's exit code is already non-zero from
       the test failure itself regardless. -->
  <Target Name="TestPulseCheckResult" AfterTargets="VSTest">
    <PropertyGroup>
      <!-- $(TargetDir) is the canonical, already-fully-resolved MSBuild
           property for the actual build output directory. Reconstructing
           it from MSBuildProjectDirectory+OutputPath is unreliable (it
           does not necessarily include the target framework subfolder,
           confirmed empirically: TestPulseLogger's own marker, written
           relative to the test host process's real working directory,
           was not found at the reconstructed path). -->
      <TestPulseResultFile>$(TargetDir).testpulse\result.json</TestPulseResultFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(TestPulseResultFile)" Condition="Exists('$(TestPulseResultFile)')">
      <Output TaskParameter="Lines" ItemName="TestPulseResultLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <!-- TestPulseLogger writes compact, single-line JSON
           (System.Text.Json's default), so ReadLinesFromFile always
           produces exactly one item. A direct string comparison
           against that exact, self-controlled format is simpler and
           more reliable than a substring/Contains check through a
           property function, which does not reliably expand an
           @(ItemName) reference embedded inside a quoted function
           argument. -->
      <TestPulseResultContent>@(TestPulseResultLines)</TestPulseResultContent>
    </PropertyGroup>
    <Error
      Text="testpulse: submission failed or was unmatched with TestPulseFailOnUnmatched set -- see the console output above for details"
      Condition="Exists('$(TestPulseResultFile)') And $(TestPulseResultContent.Contains('&quot;failed&quot;:true'))" />
  </Target>
</Project>
